generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum PlatformStaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  ACCOUNT
  BILLING
  SUBSCRIPTION
  TECHNICAL
  EXPENSE_MODULE
  PAYMENT
  RECONCILIATION
  COMPLIANCE
  OTHER
}

enum TicketMessageAuthorType {
  TENANT_USER
  PLATFORM_STAFF
}

enum OrganizationRegistrationStatus {
  LEGACY_APPROVED
  PENDING_ORGANIZATION_REVIEW
  APPROVED
  REJECTED
}

model Organization {
  expenses                    Expense[]
  id                          String                         @id @default(uuid()) @db.Uuid
  name                        String                         @db.VarChar(180)
  slug                        String?                        @unique @db.VarChar(120)
  primaryEmail                String                         @unique @db.VarChar(320)
  primaryContactName          String?                        @db.VarChar(201)
  primaryContactEmail         String?                        @db.VarChar(320)
  billingEmail                String?                        @db.VarChar(320)
  country                     String?                        @db.VarChar(100)
  defaultCurrency             String                         @default("INR") @db.Char(3)
  timezone                    String?                        @db.VarChar(80)
  status                      OrganizationStatus             @default(PROVISIONING)
  registrationStatus          OrganizationRegistrationStatus @default(LEGACY_APPROVED)
  registrationIdentifier      String?                        @db.VarChar(160)
  registrationIdentifierKey   String?                        @db.VarChar(320)
  registrationExemptionReason String?                        @db.VarChar(500)
  registrationCountry         String?                        @db.Char(2)
  normalizedDomain            String?                        @unique @db.VarChar(253)
  authorizedContactTitle      String?                        @db.VarChar(120)
  registrationSubmittedAt     DateTime?
  reviewedAt                  DateTime?
  reviewedByStaffId           String?                        @db.Uuid
  reviewNote                  String?                        @db.VarChar(2000)
  domainVerifiedAt            DateTime?
  externalCustomerRef         String?                        @unique @db.VarChar(160)
  metadata                    Json?
  statusChangedAt             DateTime?
  suspendedAt                 DateTime?
  cancelledAt                 DateTime?
  archivedAt                  DateTime?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  subscriptions               OrganizationSubscription[]
  invoices                    Invoice[]
  subscriptionPayments        SubscriptionPayment[]
  expenseCategories           ExpenseCategory[]
  expensePolicies             ExpensePolicy[]
  tenantUsers                 TenantUser[]
  tenantNotifications         TenantNotification[]
  tenantAuditLogs             TenantAuditLog[]
  employeeImportJobs          EmployeeImportJob[]
  supportTickets              SupportTicket[]

  @@unique([registrationCountry, registrationIdentifierKey])
  @@index([registrationStatus, registrationSubmittedAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

enum TenantUserStatus {
  ACTIVE
  INACTIVE
}

enum TenantRole {
  CONFIGURATION_MANAGER
  EXPENSE_SUBMITTER
  MANAGER
  FINANCE_OFFICER
  COMPLIANCE_OFFICER
}

model TenantUser {
  submittedExpenses       Expense[]           @relation("ExpenseEmployee")
  managedExpenses         Expense[]           @relation("ExpenseManager")
  financeExpenses         Expense[]           @relation("ExpenseFinance")
  phone                   String?             @db.VarChar(40)
  location                String?             @db.VarChar(180)
  avatarColor             String?             @db.VarChar(7)
  preferences             Json?
  credentialVersion       Int                 @default(0)
  credentialSetupRequired Boolean             @default(false)
  activationTokenHash     String?             @unique @db.Char(64)
  activationExpiresAt     DateTime?
  initiatedImports        EmployeeImportJob[]
  id                      String              @id @default(uuid()) @db.Uuid
  organizationId          String              @db.Uuid
  employeeId              String              @unique @db.VarChar(80)
  firstName               String              @db.VarChar(100)
  lastName                String              @db.VarChar(100)
  email                   String              @db.VarChar(320)
  passwordHash            String              @db.VarChar(255)
  role                    TenantRole          @default(EXPENSE_SUBMITTER)
  status                  TenantUserStatus    @default(ACTIVE)
  department              String              @default("General") @db.VarChar(120)
  managerId               String?             @db.Uuid
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager                 TenantUser?         @relation("TenantUserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports           TenantUser[]        @relation("TenantUserManager")

  notifications TenantNotification[]

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@unique([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, managerId])
  @@index([organizationId, firstName, lastName, id])
  @@index([organizationId, role, status, firstName, lastName, id])
}

model PlatformStaff {
  id                         String                @id @default(uuid()) @db.Uuid
  firstName                  String                @db.VarChar(100)
  lastName                   String                @db.VarChar(100)
  email                      String                @unique @db.VarChar(320)
  passwordHash               String                @db.VarChar(255)
  status                     PlatformStaffStatus   @default(ACTIVE)
  lastLoginAt                DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  roles                      PlatformStaffRole[]   @relation("PlatformStaffRoles")
  assignedRoles              PlatformStaffRole[]   @relation("PlatformStaffRoleAssigner")
  authSessions               PlatformAuthSession[]
  subscriptionHistoryEntries SubscriptionHistory[] @relation("SubscriptionHistoryActor")
  ticketMessages             TicketMessage[]       @relation("TicketMessageStaffAuthor")
  ticketNotes                TicketInternalNote[]  @relation("TicketInternalNoteStaff")
  ticketStatuses             TicketStatusHistory[] @relation("TicketStatusChangedByStaff")

  @@index([status, createdAt])
}

model PlatformRole {
  id               String                   @id @default(uuid()) @db.Uuid
  key              String                   @unique @db.VarChar(100)
  name             String                   @unique @db.VarChar(150)
  description      String?                  @db.Text
  isSystemPreset   Boolean                  @default(false)
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  rolePermissions  PlatformRolePermission[]
  staffAssignments PlatformStaffRole[]

  @@index([isActive])
}

model Permission {
  id              String                   @id @default(uuid()) @db.Uuid
  key             String                   @unique @db.VarChar(150)
  description     String                   @db.VarChar(255)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  roleAssignments PlatformRolePermission[]
}

model PlatformRolePermission {
  roleId       String       @db.Uuid
  permissionId String       @db.Uuid
  assignedAt   DateTime     @default(now())
  role         PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model PlatformStaffRole {
  staffId           String         @db.Uuid
  roleId            String         @db.Uuid
  assignedAt        DateTime       @default(now())
  assignedByStaffId String?        @db.Uuid
  staff             PlatformStaff  @relation("PlatformStaffRoles", fields: [staffId], references: [id], onDelete: Cascade)
  role              PlatformRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy        PlatformStaff? @relation("PlatformStaffRoleAssigner", fields: [assignedByStaffId], references: [id], onDelete: SetNull)

  @@id([staffId, roleId])
  @@index([roleId])
  @@index([assignedByStaffId])
}

model PlatformAuthSession {
  id               String        @id @default(uuid()) @db.Uuid
  staffId          String        @db.Uuid
  refreshTokenHash String        @unique @db.Char(64)
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  staff            PlatformStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, revokedAt])
  @@index([expiresAt])
}

// ============================================================
// PRODUCT CATALOG
// ============================================================

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum FeatureValueType {
  BOOLEAN
  INTEGER
  DECIMAL
  STRING
  JSON
}

model Plan {
  id                      String                     @id @default(uuid()) @db.Uuid
  key                     String                     @unique @db.VarChar(100)
  name                    String                     @unique @db.VarChar(150)
  description             String?                    @db.Text
  status                  PlanStatus                 @default(ACTIVE)
  billingInterval         BillingInterval
  basePrice               Decimal                    @db.Decimal(18, 4)
  currency                String                     @default("INR") @db.Char(3)
  trialDays               Int?
  includedEmployeeCount   Int                        @default(1)
  additionalEmployeePrice Decimal                    @default(0) @db.Decimal(18, 4)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  planFeatures            PlanFeature[]
  subscriptions           OrganizationSubscription[]
  invoices                Invoice[]

  @@index([status])
  @@index([billingInterval])
  @@index([createdAt])
}

model Feature {
  id           String           @id @default(uuid()) @db.Uuid
  key          String           @unique @db.VarChar(100)
  name         String           @unique @db.VarChar(150)
  description  String?          @db.Text
  valueType    FeatureValueType
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  planFeatures PlanFeature[]

  @@index([isActive])
}

model PlanFeature {
  id         String   @id @default(uuid()) @db.Uuid
  planId     String   @db.Uuid
  featureId  String   @db.Uuid
  enabled    Boolean  @default(true)
  isAddOn    Boolean  @default(false)
  addOnPrice Decimal  @default(0) @db.Decimal(18, 4)
  value      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@unique([planId, featureId])
  @@index([featureId])
}

// ============================================================
// SUBSCRIPTIONS AND BILLING
// ============================================================

enum SubscriptionStatus {
  PENDING_PAYMENT
  TRIAL
  ACTIVE
  EXPIRING
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

enum SubscriptionHistoryAction {
  ASSIGNED
  PAYMENT_ACTIVATED
  PLAN_CHANGE_REQUESTED
  PLAN_CHANGED
  RENEWED
  CANCELLED
  REACTIVATED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

enum InvoiceBillingReason {
  INITIAL
  PLAN_CHANGE
  RENEWAL
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProviderEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model OrganizationSubscription {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @db.Uuid
  planId              String                @db.Uuid
  status              SubscriptionStatus
  billingInterval     BillingInterval
  currency            String                @db.Char(3)
  priceAtSubscription Decimal               @db.Decimal(18, 4)
  employeeCount       Int                   @default(1)
  employeeAmount      Decimal               @default(0) @db.Decimal(18, 4)
  featureAmount       Decimal               @default(0) @db.Decimal(18, 4)
  selectedAddOns      Json?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  trialStartAt        DateTime?
  trialEndAt          DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan                Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  history             SubscriptionHistory[]
  invoices            Invoice[]
  payments            SubscriptionPayment[]

  @@index([organizationId, status])
  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@index([createdAt])
}

model SubscriptionHistory {
  id             String                    @id @default(uuid()) @db.Uuid
  subscriptionId String                    @db.Uuid
  action         SubscriptionHistoryAction
  previousStatus SubscriptionStatus?
  newStatus      SubscriptionStatus?
  previousPlanId String?                   @db.Uuid
  newPlanId      String?                   @db.Uuid
  actorStaffId   String?                   @db.Uuid
  note           String?                   @db.Text
  metadata       Json?
  createdAt      DateTime                  @default(now())
  subscription   OrganizationSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actorStaff     PlatformStaff?            @relation("SubscriptionHistoryActor", fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@index([actorStaffId])
}

model Invoice {
  id                 String                   @id @default(uuid()) @db.Uuid
  invoiceNumber      String                   @unique @db.VarChar(40)
  idempotencyKey     String                   @unique @db.VarChar(180)
  organizationId     String                   @db.Uuid
  subscriptionId     String                   @db.Uuid
  planId             String                   @db.Uuid
  billingReason      InvoiceBillingReason
  status             InvoiceStatus            @default(PENDING)
  subtotal           Decimal                  @db.Decimal(18, 4)
  taxAmount          Decimal                  @default(0) @db.Decimal(18, 4)
  totalAmount        Decimal                  @db.Decimal(18, 4)
  employeeCount      Int                      @default(1)
  employeeAmount     Decimal                  @default(0) @db.Decimal(18, 4)
  featureAmount      Decimal                  @default(0) @db.Decimal(18, 4)
  selectedAddOns     Json?
  currency           String                   @db.Char(3)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  issueDate          DateTime                 @default(now())
  dueDate            DateTime
  paidAt             DateTime?
  voidedAt           DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription       OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan               Plan                     @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments           SubscriptionPayment[]

  @@index([organizationId, status])
  @@index([subscriptionId, createdAt])
  @@index([planId])
  @@index([status, dueDate])
}

model SubscriptionPayment {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @db.Uuid
  invoiceId         String                    @db.Uuid
  subscriptionId    String                    @db.Uuid
  amount            Decimal                   @db.Decimal(18, 4)
  currency          String                    @db.Char(3)
  status            SubscriptionPaymentStatus @default(PENDING)
  provider          String                    @db.VarChar(50)
  providerOrderId   String                    @unique @db.VarChar(160)
  providerReference String?                   @unique @db.VarChar(160)
  paymentMethod     String?                   @db.VarChar(80)
  failureCode       String?                   @db.VarChar(120)
  failureReason     String?                   @db.VarChar(500)
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice           Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  subscription      OrganizationSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  providerEvents    PaymentProviderEvent[]

  @@index([organizationId, status])
  @@index([invoiceId])
  @@index([subscriptionId, createdAt])
  @@index([status, paidAt])
}

model PaymentProviderEvent {
  id                    String                     @id @default(uuid()) @db.Uuid
  provider              String                     @db.VarChar(50)
  eventId               String                     @db.VarChar(180)
  eventType             String                     @db.VarChar(120)
  providerOrderId       String?                    @db.VarChar(160)
  providerReference     String?                    @db.VarChar(160)
  subscriptionPaymentId String?                    @db.Uuid
  status                PaymentProviderEventStatus @default(RECEIVED)
  payload               Json?
  failureReason         String?                    @db.VarChar(500)
  receivedAt            DateTime                   @default(now())
  processedAt           DateTime?
  subscriptionPayment   SubscriptionPayment?       @relation(fields: [subscriptionPaymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([providerOrderId])
  @@index([providerReference])
  @@index([subscriptionPaymentId])
  @@index([receivedAt])
}

// ============================================================
// PLATFORM AUDIT LOG
// ============================================================

model PlatformAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorStaffId String?  @db.Uuid
  action       String   @db.VarChar(150)
  resourceType String   @db.VarChar(100)
  resourceId   String?  @db.Uuid
  oldValue     Json?
  newValue     Json?
  metadata     Json?
  ipAddress    String?  @db.VarChar(45)
  requestId    String?  @db.VarChar(100)
  createdAt    DateTime @default(now())

  @@index([actorStaffId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
}

model SupportTicket {
  id              String                @id @default(uuid()) @db.Uuid
  ticketNumber    String                @unique @db.VarChar(40)
  organizationId  String                @db.Uuid
  requesterUserId String?               @db.Uuid
  requesterName   String?               @db.VarChar(160)
  requesterEmail  String?               @db.VarChar(320)
  category        TicketCategory
  priority        TicketPriority
  subject         String                @db.VarChar(200)
  description     String                @db.Text
  status          TicketStatus          @default(OPEN)
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  messages        TicketMessage[]
  internalNotes   TicketInternalNote[]
  statusHistory   TicketStatusHistory[]

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
}

model TicketMessage {
  id            String                  @id @default(uuid()) @db.Uuid
  ticketId      String                  @db.Uuid
  authorType    TicketMessageAuthorType
  authorUserId  String?                 @db.Uuid
  authorStaffId String?                 @db.Uuid
  message       String                  @db.Text
  createdAt     DateTime                @default(now())
  ticket        SupportTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorStaff   PlatformStaff?          @relation("TicketMessageStaffAuthor", fields: [authorStaffId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorStaffId])
  @@index([authorUserId])
}

model TicketInternalNote {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  staffId   String        @db.Uuid
  note      String        @db.Text
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staff     PlatformStaff @relation("TicketInternalNoteStaff", fields: [staffId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([staffId])
}

model TicketStatusHistory {
  id               String         @id @default(uuid()) @db.Uuid
  ticketId         String         @db.Uuid
  previousStatus   TicketStatus?
  newStatus        TicketStatus
  changedByStaffId String?        @db.Uuid
  changedByUserId  String?        @db.Uuid
  note             String?        @db.Text
  createdAt        DateTime       @default(now())
  ticket           SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedByStaff   PlatformStaff? @relation("TicketStatusChangedByStaff", fields: [changedByStaffId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([newStatus])
  @@index([changedByStaffId])
  @@index([changedByUserId])
}

// Tenant configuration shared with the durable expense lifecycle below.
model ExpenseCategory {
  expenses        Expense[]
  templateKey     String?         @db.VarChar(80)
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  name            String          @db.VarChar(100)
  description     String          @default("")
  limit           Decimal         @default(0) @db.Decimal(12, 2)
  currency        String          @default("INR") @db.Char(3)
  status          String          @default("Active") @db.VarChar(20)
  requiresReceipt Boolean         @default(true)
  color           String          @default("#7C3AED") @db.VarChar(7)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policies        ExpensePolicy[]
  // Case-insensitive name uniqueness and checks are enforced in migration SQL.

  @@unique([organizationId, id])
  @@unique([organizationId, templateKey])
  @@index([organizationId, status])
}

model ExpensePolicy {
  templateKey      String?         @db.VarChar(80)
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  categoryId       String          @db.Uuid
  name             String          @db.VarChar(100)
  description      String          @default("")
  maxAmount        Decimal         @db.Decimal(12, 2)
  currency         String          @default("INR") @db.Char(3)
  approval         String          @default("Manager Approval") @db.VarChar(100)
  status           String          @default("Active") @db.VarChar(20)
  requiresApproval Boolean         @default(true)
  receiptRequired  Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category         ExpenseCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, templateKey])
  @@index([organizationId, categoryId])
  @@index([organizationId, status])
}

model EmployeeImportJob {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  createdById     String              @db.Uuid
  confirmedById   String?             @db.Uuid
  idempotencyKey  String              @db.Uuid
  fileHash        String              @db.Char(64)
  status          String              @default("VALIDATING") @db.VarChar(20)
  totalCount      Int                 @default(0)
  validCount      Int                 @default(0)
  invalidCount    Int                 @default(0)
  processedCount  Int                 @default(0)
  successfulCount Int                 @default(0)
  failedCount     Int                 @default(0)
  retries         Int                 @default(0)
  error           String?             @db.VarChar(500)
  leaseToken      String?             @db.Uuid
  leaseExpiresAt  DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  confirmedAt     DateTime?
  completedAt     DateTime?
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       TenantUser          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  rows            EmployeeImportRow[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([status, leaseExpiresAt])
}

model EmployeeImportRow {
  id         String            @id @default(uuid()) @db.Uuid
  jobId      String            @db.Uuid
  rowNumber  Int
  employeeId String            @db.VarChar(80)
  email      String            @db.VarChar(320)
  payload    Json
  status     String            @db.VarChar(20)
  errors     String[]
  userId     String            @db.Uuid
  job        EmployeeImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([jobId, status, rowNumber])
  @@index([jobId, employeeId])
  @@index([jobId, email])
}

// Actor snapshots intentionally have no mutable TenantUser foreign key.
model TenantAuditLog {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId       String?      @db.Uuid
  actorKind         String       @db.VarChar(16)
  actorName         String       @db.VarChar(201)
  actorRole         TenantRole?
  initiatedByUserId String?      @db.Uuid
  eventCode         String       @db.VarChar(100)
  targetType        String       @db.VarChar(40)
  targetId          String       @db.VarChar(80)
  outcome           String       @default("SUCCESS") @db.VarChar(20)
  occurredAt        DateTime     @default(now())
  changes           Json

  @@index([organizationId, occurredAt, id])
  @@index([organizationId, eventCode, occurredAt])
  @@index([organizationId, targetType, targetId, occurredAt])
  @@index([organizationId, actorUserId, occurredAt])
}

model TenantNotification {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  recipientUserId String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient       TenantUser   @relation(fields: [organizationId, recipientUserId], references: [organizationId, id], onDelete: Cascade, map: "TenantNotification_recipient_fkey")
  eventCode       String       @db.VarChar(100)
  eventKey        String       @db.VarChar(320)
  type            String       @db.VarChar(20)
  title           String       @db.VarChar(200)
  message         String       @db.VarChar(2000)
  sourceType      String?      @db.VarChar(40)
  sourceId        String?      @db.VarChar(100)
  createdAt       DateTime     @default(now())
  readAt          DateTime?
  dismissedAt     DateTime?

  @@unique([organizationId, recipientUserId, eventKey])
  @@index([organizationId, recipientUserId, dismissedAt, createdAt, id], map: "TenantNotification_recipient_page_idx")
  @@index([organizationId, recipientUserId, dismissedAt, readAt], map: "TenantNotification_recipient_unread_idx")
}

model Expense {
  submissionKey            String?                @db.VarChar(100)
  submissionFingerprint    String?                @db.Char(64)
  id                       String                 @id @default(uuid()) @db.Uuid
  organizationId           String                 @db.Uuid
  employeeId               String                 @db.VarChar(80)
  managerEmployeeId        String                 @db.VarChar(80)
  assignedFinanceOfficerId String?                @db.Uuid
  categoryId               String                 @db.Uuid
  amount                   Decimal                @db.Decimal(18, 2)
  currency                 String                 @db.Char(3)
  merchant                 String                 @db.VarChar(500)
  date                     DateTime
  status                   String                 @db.VarChar(20)
  workflowStatus           String                 @db.VarChar(40)
  notes                    String                 @default("") @db.Text
  paymentMethod            String                 @db.VarChar(100)
  receiptFileName          String                 @default("") @db.VarChar(500)
  // Compatibility projections for decisions and optional extraction hints.
  details                  Json                   @default("{}")
  deletedAt                DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee                 TenantUser             @relation("ExpenseEmployee", fields: [organizationId, employeeId], references: [organizationId, employeeId], onDelete: Restrict)
  manager                  TenantUser             @relation("ExpenseManager", fields: [organizationId, managerEmployeeId], references: [organizationId, employeeId], onDelete: Restrict)
  financeOfficer           TenantUser?            @relation("ExpenseFinance", fields: [organizationId, assignedFinanceOfficerId], references: [organizationId, id], onDelete: Restrict)
  category                 ExpenseCategory        @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  history                  ExpenseStatusHistory[]
  receipt                  Receipt?
  payments                 ExpensePayment[]

  @@unique([organizationId, id])
  @@unique([organizationId, employeeId, submissionKey])
  @@index([organizationId, employeeId, createdAt])
  @@index([organizationId, managerEmployeeId, workflowStatus])
  @@index([organizationId, assignedFinanceOfficerId, workflowStatus])
  @@index([organizationId, workflowStatus])
}

// Append-only decisions and transitions; actor UUID is an immutable snapshot.
model ExpenseStatusHistory {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  expenseId      String     @db.Uuid
  sequence       Int
  actorUserId    String     @db.Uuid
  actorRole      TenantRole
  previousStatus String?    @db.VarChar(40)
  newStatus      String     @db.VarChar(40)
  code           String     @db.VarChar(100)
  label          String     @db.VarChar(200)
  note           String     @db.Text
  at             DateTime   @default(now())
  expense        Expense    @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([expenseId, sequence])
  @@index([organizationId, expenseId, at])
}

model Receipt {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  expenseId      String   @unique @db.Uuid
  originalName   String   @db.VarChar(500)
  storageName    String   @unique @db.VarChar(100)
  mimeType       String   @db.VarChar(80)
  size           Int
  uploadedAt     DateTime @default(now())
  expense        Expense  @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, expenseId])
}

// An internal processing request. Pending does not mean money was sent or settled.
model ExpensePayment {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @db.Uuid
  expenseId              String    @unique @db.Uuid
  batchId                String    @db.VarChar(80)
  amount                 Decimal   @db.Decimal(18, 2)
  currency               String    @db.Char(3)
  status                 String    @default("pending") @db.VarChar(20)
  requestedById          String    @db.Uuid
  transactionDate        DateTime  @default(now())
  processedAt            DateTime?
  bankReference          String?   @db.VarChar(160)
  reconciliationMetadata Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  expense                Expense   @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
}
